# Wi-Fi / hotspot — WZÓR (przykładowe nazwy, NIE sieć domu autora)
#
# 1) Skopiuj ten plik na Pico jako:  secrets.py
# 2) Opcjonalnie zmień AP_SSID / AP_PASSWORD (widać je na OLED — to hasło URZĄDZENIA)
# 3) Sieci domu dodawaj z przeglądarki (panel WWW) albo odkomentuj WIFI_NETWORKS
# 4) NIE commituj secrets.py  ·  w GitHubie zostaje TYLKO ten plik .example
#
# Przepływ firmware:
#   start → hotspot Pico → http://192.168.4.1/ → join Wi‑Fi domu (2,4 GHz)
#   → AP OFF → panel na IP z OLED
#
# Hasło sieci domu NIGDY nie trafia na OLED ani do README.

# --- Hotspot Pico (AP-first; wolno pokazać publicznie) ---
AP_SSID = "Miernik-Pico"
AP_PASSWORD = "miernik123"  # min. 8 znaków (WPA2); puste = sieć otwarta

# Sieci domu — zostaw PUSTE w Gicie.
# Kolejność = priorytet przy „Połącz z zapisanymi”.
WIFI_NETWORKS = [
    # {
    #     "ssid": "NazwaTwojejSieci_24GHz",
    #     "password": "haslo_ktore_wpisujesz_tylko_na_plytce",
    # },
]

WIFI_TRY_SECONDS = 12
WEB_PORT = 80

# OLED: poza hotspotem gaśnie po tym czasie (przycisk budzi). Pomiary + WWW dalej.
# Ta sama liczba co SLEEP_MS w main.py.
DISPLAY_SLEEP_MS = 60000  # 60 s
